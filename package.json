{
  "name": "workpulse_backend",
  "version": "2.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "node --env-file=.env.local ./node_modules/nodemon/bin/nodemon.js server.js",
    "start": "node --env-file=.env.local server.js",
    "build": "prisma generate",
    "build:db": "prisma generate && prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:local:deploy": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:local:push": "node --env-file=.env.local ./node_modules/prisma/build/index.js db push",
    "db:local:seed": "node --env-file=.env.local scripts/seed_demo_accounts.js",
    "db:local:setup": "npm run db:local:push && npm run db:local:seed",
    "db:push": "prisma db push",
    "test": "node --test --test-concurrency=1 tests/auth.test.js tests/tenant.test.js tests/attendance.test.js tests/leave.test.js tests/payroll.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@messagebird/sdk": "^0.65.1",
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "nodemailer": "^10.0.9",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "twilio": "^6.1.1",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "mysql2": "^3.24.0"
  }
}
