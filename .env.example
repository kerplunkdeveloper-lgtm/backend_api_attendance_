# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Razorpay Live Mode
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-live-api-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-the-secret-created-in-razorpay-webhooks

# Application
FRONTEND_URL=https://your-frontend-domain.example
NODE_ENV=production
