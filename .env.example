# Database
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_SECRET=replace-with-a-different-long-random-secret

# Razorpay Live Mode
RAZORPAY_KEY_ID=rzp_live_replace_me
RAZORPAY_KEY_SECRET=replace-with-razorpay-live-api-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-the-secret-created-in-razorpay-webhooks

# SaaS pricing in INR (server-owned; restart API after changing)
PLAN_STARTER_MONTHLY_INR=2499
PLAN_STARTER_ANNUAL_INR=24990
PLAN_PROFESSIONAL_MONTHLY_INR=6999
PLAN_PROFESSIONAL_ANNUAL_INR=69990
PLAN_ENTERPRISE_MONTHLY_INR=16999
PLAN_ENTERPRISE_ANNUAL_INR=169990

# Application
FRONTEND_URL=https://your-frontend-domain.example
NODE_ENV=production
HOST=0.0.0.0
PORT=5000
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
DB_HEALTHCHECK_TIMEOUT_MS=10000

# Optional distributed services
REDIS_URL=redis://user:password@host:6379
ENABLE_SCHEDULER=false
ENABLE_WEBSOCKETS=false

# Email delivery (Brevo transactional email API)
BREVO_API_KEY=
BREVO_FROM_EMAIL=notifications@your-domain.example
BREVO_FROM_NAME=WorkPulse

# File uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# WhatsApp notifications (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Google sign-in (optional)
GOOGLE_CLIENT_ID=

# Billing tax rate, as a percentage
BILLING_TAX_RATE=0

# Direct (non-pooled) Neon URL used by Prisma migrations. Neon branch checkouts
# provide DATABASE_URL_UNPOOLED; it is preferred over a stale DIRECT_URL.
DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
DIRECT_URL=

# Separate refresh-token secret (falls back to JWT_SECRET)
REFRESH_TOKEN_SECRET=replace-with-another-long-random-secret

# Public URL of this API
BACKEND_URL=https://your-api.example.com

# Optional: prefer an IP family for DB connections (ipv4first | ipv6first | verbatim).
# Set to ipv6first if logins time out locally while the database is healthy.
# DB_DNS_RESULT_ORDER=
