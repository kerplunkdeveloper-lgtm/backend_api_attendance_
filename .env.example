PORT=5000
NODE_ENV=development
FRONTEND_URL=https://workpl.netlify.app

# PostgreSQL / Neon Database URL
DATABASE_URL="postgresql://user:password@host-pooler.region.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host.region.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# JWT Authentication Secrets
JWT_SECRET="your-jwt-secret"
ACCESS_TOKEN_SECRET="your-access-token-secret"
REFRESH_TOKEN_SECRET="your-refresh-token-secret"

# Email Configuration (Nodemailer / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="WorkPulse Notifications <notifications@workpulse.com>"

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Twilio (Optional)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER="whatsapp:+14155238886"
TWILIO_PHONE_NUMBER=""
