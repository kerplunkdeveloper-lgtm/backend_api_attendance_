FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"workpluse-production","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-...@workpluse-production.iam.gserviceaccount.com","client_id":"...","universe_domain":"googleapis.com"}

# Observability and readiness tuning
SLOW_API_THRESHOLD_MS=1000
DB_HEALTHCHECK_TIMEOUT_MS=10000

# Authenticated API audit tuning
API_AUDIT_SLOW_THRESHOLD_MS=1000
API_AUDIT_TIMEOUT_MS=15000
API_AUDIT_FAIL_ON_SLOW=false

# Local development can use Cloudinary:
STORAGE_PROVIDER=cloudinary
# Production must use S3. Set these in the production environment, not in Git.
# STORAGE_PROVIDER=s3
# AWS_REGION=ap-south-1
# S3_BUCKET_NAME=your-private-bucket
# AWS credentials must come from the runtime IAM role or the standard AWS credential chain.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_ASSISTANT_ENABLED=false
AI_MONTHLY_BUDGET_USD=25
