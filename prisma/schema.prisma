// ── Employee Invite — tracks email invitations sent by Admin with auto-generated credentials ──
model EmployeeInvite {
  id             String   @id @default(uuid())
  organizationId String
  email          String
  firstName      String
  lastName       String?
  role           String   @default("EMPLOYEE")  // EMPLOYEE | MANAGER
  tempPassword   String   // bcrypt hash only — plaintext is returned once in the invite API response
  employeeId     String?  // linked after account is created
  userId         String?  // linked user account
  status         String   @default("PENDING")  // PENDING | ACCEPTED | EXPIRED
  invitedBy      String   // userId of admin who sent the invite
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, status])
  @@index([email])
}

// ─── Employee Documents ───────────────────────────────────────────────────────
enum EmployeeDocumentType {
  AADHAAR
  PAN
  PASSPORT
  DRIVING_LICENCE
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  OFFER_LETTER
  EMPLOYMENT_CONTRACT
  BANK_DOCUMENT
  OTHER
}

model EmployeeDocument {
