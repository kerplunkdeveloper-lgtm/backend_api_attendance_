  section80D              Decimal  @default(0) @db.Decimal(12, 2)
  homeLoanInterest        Decimal  @default(0) @db.Decimal(12, 2)
  npsEmployee             Decimal  @default(0) @db.Decimal(12, 2)
  otherExemptions         Decimal  @default(0) @db.Decimal(12, 2)
  previousEmployerIncome  Decimal  @default(0) @db.Decimal(12, 2)
  previousEmployerTds     Decimal  @default(0) @db.Decimal(12, 2)
